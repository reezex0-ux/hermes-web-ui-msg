# The Hermes Dashboard endpoint reachable from inside the container.
HERMES_UPSTREAM=http://host.docker.internal:9119

# The exact host and origin accepted by your Hermes Dashboard process.
# Keep these aligned with the host the dashboard was started with.
HERMES_BACKEND_HOST=host.docker.internal:9119
HERMES_BACKEND_ORIGIN=http://host.docker.internal:9119

# "live" connects to your Hermes Dashboard. GitHub Pages builds set this to "demo".
NEXT_PUBLIC_HERMES_MODE=live

# Leave empty when serving at the domain root. Set only for a subpath deployment.
NEXT_PUBLIC_BASE_PATH=
